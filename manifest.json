{
  "manifest_version": 3,
  "name": "NTHU OJ Helper",
  "version": "4.4",
  "description": "NTHU OJ 自動化輔助工具：批量提交程式碼、Status 頁增強、批量上傳測資、Markdown + LaTeX 出題",
  "content_scripts": [
    {
      "matches": ["*://140.114.86.166/*", "*://acm.cs.nthu.edu.tw/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://140.114.86.166/problem/*",
        "*://acm.cs.nthu.edu.tw/problem/*"
      ],
      "js": [
        "vendor/mathjax-config.js",
        "vendor/marked.min.js",
        "vendor/tex-svg.js",
        "editor.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}
