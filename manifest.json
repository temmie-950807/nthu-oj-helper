{
  "manifest_version": 3,
  "name": "NTHU OJ Helper",
  "version": "9.0",
  "description": "NTHU OJ 出題與刷題輔助：全站介面改造、Markdown + LaTeX 出題、題目 zip 匯入匯出、批量提交、Status 頁增強",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://140.114.86.166/*",
        "*://acm.cs.nthu.edu.tw/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://140.114.86.166/*",
        "*://acm.cs.nthu.edu.tw/*"
      ],
      "js": [
        "guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://140.114.86.166/*",
        "*://acm.cs.nthu.edu.tw/*"
      ],
      "css": [
        "tokens.css",
        "site.css",
        "dark.css"
      ],
      "js": [
        "content.js",
        "site.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://140.114.86.166/problem/*",
        "*://acm.cs.nthu.edu.tw/problem/*"
      ],
      "css": [
        "ui.css",
        "tag.css",
        "testcase.css",
        "sample.css"
      ],
      "js": [
        "vendor/mathjax-config.js",
        "vendor/marked.min.js",
        "vendor/tex-svg.js",
        "vendor/fflate.min.js",
        "vendor/codemirror.js",
        "editor.js",
        "transfer.js",
        "ui.js",
        "tag.js",
        "testcase.js",
        "sample.js",
        "list.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://140.114.86.166/contest/*",
        "*://acm.cs.nthu.edu.tw/contest/*"
      ],
      "css": [
        "contest.css",
        "scoreboard.css"
      ],
      "js": [
        "vendor/fflate.min.js",
        "contest.js",
        "scoreboard.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/fonts/*.woff2"
      ],
      "matches": [
        "*://140.114.86.166/*",
        "*://acm.cs.nthu.edu.tw/*"
      ]
    }
  ]
}
